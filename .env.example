# Server-side only (Vercel serverless functions under api/) -- no VITE_
# prefix, so these never reach the client bundle.
# PMI_API_URL / WMS_API_URL: VOMA gateway hostnames the proxy forwards to,
# e.g. https://api-pim.dev.voma.vn / https://api-wms.dev.voma.vn
PMI_API_URL=
WMS_API_URL=
# Catalog-grant token (POST /site/token on voma-identity, seller-scoped,
# catalog:read only). Mint per environment; do not commit a real value.
CATALOG_GRANT_TOKEN=
