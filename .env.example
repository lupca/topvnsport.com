# Server-side only (Vercel serverless functions under api/) -- no VITE_
# prefix, so these never reach the client bundle.
# PMI_API_URL / WMS_API_URL: VOMA gateway hostnames the proxy forwards to,
# e.g. https://api-pim.dev.voma.vn / https://api-wms.dev.voma.vn
PMI_API_URL=
WMS_API_URL=
# Catalog-grant tokens, one per seller (POST /site/token on voma-identity,
# seller-scoped, catalog:read only). JSON map keyed by seller_id, e.g.
# CATALOG_GRANT_TOKENS={"seller-a":"<token-a>","seller-b":"<token-b>"}
# Mint per environment; do not commit real values.
CATALOG_GRANT_TOKENS=
# Which seller_id (a key in CATALOG_GRANT_TOKENS above) this deployment
# serves. Server-side only -- never a VITE_ var -- because today one
# deployment always serves exactly one seller.
STOREFRONT_SELLER_ID=

# Hồ sơ người bán (build-time, client bundle) -- MỘT biến JSON, đặt trên Vercel.
# Đổi giá trị = sửa biến + redeploy, không sửa mã. Mọi trường đều tuỳ chọn: thiếu/rỗng
# thì storefront KHÔNG hiện mục đó (không giá trị mặc định). JSON sai cú pháp, trường lạ
# hoặc sai kiểu thì `vite build` hỏng và thông báo nêu rõ trường sai.
# Giá trị thật do chủ sản phẩm cung cấp, coordinator đặt trên Vercel -- KHÔNG ghi vào repo.
# Trường chuỗi:
#   hotline, hotlineHours, email, address      liên hệ (Footer, Header, StoreLocator)
#   businessLicense                            dòng giấy phép ĐKKD (Footer)
#   tagline, footerSlogan                      lời tự giới thiệu (Footer)
#   authenticityPolicy                         cam kết chính hãng (Footer, Header, TrustBadges, TrustSealsPanel)
#   warrantyPolicy                             bảo hành chung (Footer, TrustBadges)
#   stringWarrantyPolicy                       bảo hành lưới (TrustSealsPanel)
#   frameWarrantyPolicy                        bảo hành khung vợt (giỏ hàng)
#   orderWarrantyNote                          ghi chú bảo hành sau đặt hàng (giỏ hàng)
#   headquartersNote                           trụ sở (Footer, ô "Cửa hàng trải nghiệm")
#   codPolicy                                  thanh toán khi nhận hàng (TrustBadges)
#   storeNote                                  cửa hàng (TrustBadges)
# branches: mảng {id, name, address} bắt buộc; phone, schedule, city, mapEmbedUrl tuỳ chọn.
# Ví dụ (toàn giá trị GIẢ):
VITE_SELLER_PROFILE={"hotline":"HOTLINE-GIA-0001","hotlineHours":"GIO-GIA","email":"gia@example.invalid","address":"DIA-CHI-GIA 1","businessLicense":"ĐKKD GIẢ 0000","tagline":"TAGLINE-GIA","footerSlogan":"SLOGAN-GIA","authenticityPolicy":"CHINH-HANG-GIA","warrantyPolicy":"BAO-HANH-GIA","stringWarrantyPolicy":"BAO-HANH-LUOI-GIA","frameWarrantyPolicy":"BAO-HANH-KHUNG-GIA","orderWarrantyNote":"GHI-CHU-DON-GIA","headquartersNote":"TRU-SO-GIA","codPolicy":"COD-GIA","storeNote":"CUA-HANG-GIA","branches":[{"id":"chi-nhanh-gia","name":"CHI-NHANH-GIA","address":"DIA-CHI-GIA 2","phone":"SDT-GIA-0002","schedule":"GIO-GIA","city":"THANH-PHO-GIA"}]}
