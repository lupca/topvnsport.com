# Server-side only (Vercel serverless functions under api/) -- no VITE_
# prefix, so these never reach the client bundle.
# PMI_API_URL / WMS_API_URL: VOMA gateway hostnames the proxy forwards to,
# e.g. https://api-pim.dev.voma.vn / https://api-wms.dev.voma.vn
PMI_API_URL=
WMS_API_URL=
# Catalog-grant tokens, one per seller (POST /site/token on voma-identity,
# seller-scoped, catalog:read only). JSON map keyed by seller_id, e.g.
# CATALOG_GRANT_TOKENS={"seller-a":"<token-a>","seller-b":"<token-b>"}
# Mint per environment; do not commit real values.
CATALOG_GRANT_TOKENS=
# Which seller_id (a key in CATALOG_GRANT_TOKENS above) this deployment
# serves. Server-side only -- never a VITE_ var -- because today one
# deployment always serves exactly one seller.
STOREFRONT_SELLER_ID=
